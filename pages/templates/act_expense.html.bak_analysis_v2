                        <span style="color: {% if expense.act_expense_approved == 'Yes' %}#32CD32{% else %}#DC143C{% endif %};">
                            {% if expense.act_expense_approved == 'Yes' %}Approved{% else %}Pending{% endif %}
                        </span>
                    </button>
                {% endif %}
            </td>
            <td data-label="Paid?" class="cell-action">
                {% if user.is_superuser %}
                    {% if expense.act_expense_paid == 'Yes' %}
                        <button type="button" class="status-btn is-disabled" disabled>
                            <span style="color: #32CD32;">Paid</span>
                        </button>
                    {% elif expense.act_expense_approved == 'Yes' %}
                        <form method="post" action="{% url 'mark_paid' expense.act_expense_id %}" style="display:inline; width: 100%;">
                            {% csrf_token %}
                            <button type="submit" class="status-btn">
                                <span style="color: #007bff;">Pay</span>
                            </button>
                        </form>
                    {% else %}
                        <button type="button" class="status-btn is-disabled" disabled>
                            <span style="color: #DC143C;">Approve First</span>
                        </button>
                    {% endif %}
                {% else %}
                    <button type="button" class="status-btn is-disabled" disabled>
                        <span style="color: {% if expense.act_expense_paid == 'Yes' %}#32CD32{% else %}#DC143C{% endif %};">
                            {% if expense.act_expense_paid == 'Yes' %}Paid{% else %}Pending{% endif %}
                        </span>
                    </button>
                {% endif %}
            </td>
        {% endif %}
    </tr>
    {% endfor %}
</tbody>
</table>
