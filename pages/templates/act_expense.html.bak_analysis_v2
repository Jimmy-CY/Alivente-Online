</style>
<div class="modal fade" id="expenseAnalysisModal" tabindex="-1" role="dialog" aria-labelledby="expenseAnalysisLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg analysis-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="expenseAnalysisLabel">
          <i class="fas fa-chart-line" style="color:#17a2b8;"></i> Expenses vs Rent — Analysis
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <div class="modal-body">
        <div class="report-year-bar">
          <span class="report-year-label"><i class="fas fa-calendar-alt"></i> Years:</span>
          <label class="report-year-chk"><input type="checkbox" id="analysisYearAll" checked> All years</label>
          <span id="analysisYearList" class="report-year-list"></span>
        </div>
        <p class="analysis-sub" id="analysisSub"></p>
        <div id="analysisLoading" class="text-center text-muted" style="padding:30px;">
          <i class="fas fa-spinner fa-spin"></i> Loading...
        </div>
        <div id="analysisEmpty" class="text-center text-muted" style="display:none; padding:30px;">
          Not enough data to compare yet.
        </div>
        <div id="analysisContent" style="display:none;">
          <div class="analysis-chart-wrap"><canvas id="analysisChart"></canvas></div>
          <div class="analysis-quad-key" id="analysisQuadKey" style="display:none;">
            <div class="qk danger"><b>&#9888; Watch &middot; top-left</b>Surprise costs over 10% of rent while rent is flat or falling.</div>
            <div class="qk"><b>Costs high, rent rising &middot; top-right</b>Surprises are high, but rent is growing to cover them.</div>
            <div class="qk"><b>Rent stalled &middot; bottom-left</b>Surprise costs low, but rent isn't growing.</div>
            <div class="qk good"><b>&#10003; Healthy &middot; bottom-right</b>Rent growing and surprise costs low.</div>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover analysis-table">
              <thead>
                <tr>
                  <th>Property</th>
                  <th class="num">Rent</th>
                  <th class="text-center">Let</th>
                  <th class="num">Actual</th>
                  <th class="num">% of rent</th>
                  <th class="num">Rent &Delta;</th>
                  <th class="text-center">Status</th>
                </tr>
              </thead>
              <tbody id="analysisTableBody"></tbody>
            </table>
          </div>
          <p class="text-muted small mb-0" id="analysisNote"></p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
    'use strict';
    var ANALYSIS_URL = "{% url 'act_expense_analysis_data' %}";
    var DANGER_PCT = 10;
    var chart = null, loaded = false, DATA = null;

    function euro(n) { return '€' + Number(n || 0).toLocaleString('en-IE', {maximumFractionDigits: 0}); }
    function pct(n) { return (n > 0 ? '+' : '') + Number(n).toFixed(1) + '%'; }
    function escapeHtml(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function effectiveYears() {
        var all = document.getElementById('analysisYearAll').checked;
        var picked = [];
        document.querySelectorAll('#analysisYearList input[type=checkbox]:checked').forEach(function(cb){ picked.push(parseInt(cb.value, 10)); });
        if (all || picked.length === 0) return (DATA.available_years || []).slice();
        return picked;
    }

    function buildYearCheckboxes(years) {
        var list = document.getElementById('analysisYearList');
        if (list.dataset.built === '1') return;
        list.innerHTML = '';
        years.forEach(function(y) {
            var lbl = document.createElement('label');
            lbl.className = 'report-year-chk';
            lbl.innerHTML = '<input type="checkbox" value="' + y + '"> ' + y;
            list.appendChild(lbl);
        });
        list.dataset.built = '1';
        var allCb = document.getElementById('analysisYearAll');
        allCb.addEventListener('change', function() {
            if (allCb.checked) list.querySelectorAll('input[type=checkbox]').forEach(function(cb){ cb.checked = false; });
            else if (list.querySelectorAll('input[type=checkbox]:checked').length === 0) { allCb.checked = true; return; }
            render();
        });
        list.querySelectorAll('input[type=checkbox]').forEach(function(cb) {
            cb.addEventListener('change', function() {
                if (cb.checked) allCb.checked = false;
                if (list.querySelectorAll('input[type=checkbox]:checked').length === 0) allCb.checked = true;
                render();
            });
        });
    }

    function bubbleRadiusScale(vals) {
        var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);
        return function(v) { return (max === min) ? 11 : 7 + (v - min) / (max - min) * 15; };
    }

    function load() {
        var loading = document.getElementById('analysisLoading');
        var empty = document.getElementById('analysisEmpty');
        var content = document.getElementById('analysisContent');
        loading.style.display = 'block'; empty.style.display = 'none'; content.style.display = 'none';
        fetch(ANALYSIS_URL, {headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function(r){ return r.json(); })
            .then(function(data) {
                DATA = data;
                buildYearCheckboxes(data.available_years || []);
                loading.style.display = 'none';
                render();
            })
            .catch(function(err) {
                loading.innerHTML = '<span class="text-danger">Failed to load analysis.</span>';
                console.error('Analysis load error:', err);
            });
    }

    function render() {
        if (!DATA) return;
        var empty = document.getElementById('analysisEmpty');
        var content = document.getElementById('analysisContent');
        var quadKey = document.getElementById('analysisQuadKey');
        var years = effectiveYears().slice().sort(function(a,b){ return a - b; });
        var single = years.length < 2;
        var y0 = years[0], y1 = years[years.length - 1];

        var rows = [];
        (DATA.properties || []).forEach(function(p) {
            var a = p.years[y0], b = p.years[y1];
            if (!b) return;
            var rentNow = b.rent, actual = b.actual;
            var pctRent = rentNow ? (actual / rentNow * 100) : null;
            var change = (!single && a && a.rent) ? ((b.rent - a.rent) / a.rent * 100) : null;
            rows.push({
                id: p.prop_id, name: p.prop_name,
                rent: rentNow, let: b.months_let, actual: actual,
                pctRent: pctRent, change: change, source: b.source,
                danger: (pctRent != null && pctRent >= DANGER_PCT && (change == null || change <= 0))
            });
        });
        rows = rows.filter(function(r){ return r.rent || r.actual; });

        if (!rows.length) { empty.style.display = 'block'; content.style.display = 'none'; return; }
        content.style.display = 'block'; empty.style.display = 'none';

        document.getElementById('analysisSub').innerHTML = single
            ? ('Ranking properties by actual (ad-hoc) spend as a % of rent for <b>' + y1 + '</b>. Tick 2+ years to compare movement.')
            : ('Each bubble is a property. X = rent change ' + y0 + '→' + y1 + '. Y = actual spend as % of rent (' + y1 + '). Bubble size = rent.');

        quadKey.style.display = single ? 'none' : 'grid';
        if (single) renderRanking(rows, y1); else renderScatter(rows, y0, y1);
        renderTable(rows, single);

        var flagged = rows.filter(function(r){ return r.danger; }).length;
        document.getElementById('analysisNote').innerHTML = flagged
            ? ('<i class="fas fa-exclamation-triangle" style="color:#dc3545;"></i> ' + flagged + ' propert' + (flagged>1?'ies':'y') + ' in the watch zone.')
            : 'No properties in the watch zone.';
    }

    // Chart.js inline plugin: quadrant tints, divider lines, corner labels.
    var quadrantPlugin = {
        id: 'quadrants',
        beforeDatasetsDraw: function(chart) {
            var xs = chart.scales.x, ys = chart.scales.y, area = chart.chartArea, ctx = chart.ctx;
            if (!xs || !ys) return;
            var x0 = Math.max(area.left, Math.min(area.right, xs.getPixelForValue(0)));
            var y10 = Math.max(area.top, Math.min(area.bottom, ys.getPixelForValue(DANGER_PCT)));
            ctx.save();
            ctx.fillStyle = 'rgba(220,53,69,0.06)';            // watch (top-left)
            ctx.fillRect(area.left, area.top, x0 - area.left, y10 - area.top);
            ctx.fillStyle = 'rgba(40,167,69,0.05)';            // healthy (bottom-right)
            ctx.fillRect(x0, y10, area.right - x0, area.bottom - y10);
            ctx.setLineDash([5, 4]); ctx.lineWidth = 1;
            ctx.strokeStyle = 'rgba(0,0,0,0.28)';              // vertical: rent flat
            ctx.beginPath(); ctx.moveTo(x0, area.top); ctx.lineTo(x0, area.bottom); ctx.stroke();
            ctx.strokeStyle = '#dc3545';                       // horizontal: 10% of rent
            ctx.beginPath(); ctx.moveTo(area.left, y10); ctx.lineTo(area.right, y10); ctx.stroke();
            ctx.restore();
        },
        afterDatasetsDraw: function(chart) {
            var area = chart.chartArea, ctx = chart.ctx;
            ctx.save();
            ctx.font = '600 10px system-ui, sans-serif';
            ctx.textBaseline = 'top'; ctx.textAlign = 'left';
            ctx.fillStyle = 'rgba(176,42,55,0.8)';
            ctx.fillText('⚠ Watch', area.left + 6, area.top + 4);
            ctx.textAlign = 'right'; ctx.fillStyle = 'rgba(108,117,125,0.75)';
            ctx.fillText('Costs high, rent rising', area.right - 6, area.top + 4);
            ctx.textBaseline = 'bottom'; ctx.textAlign = 'left';
            ctx.fillText('Rent stalled', area.left + 6, area.bottom - 4);
            ctx.textAlign = 'right'; ctx.fillStyle = 'rgba(31,122,55,0.85)';
            ctx.fillText('✓ Healthy', area.right - 6, area.bottom - 4);
            ctx.restore();
        }
    };

    function renderScatter(rows, y0, y1) {
        document.querySelector('.analysis-chart-wrap').style.height = '';  // use CSS height
        var pts = rows.filter(function(r){ return r.change != null && r.pctRent != null; });
        var rScale = bubbleRadiusScale(pts.map(function(r){ return r.rent || 0; }));
        var data = pts.map(function(r){ return {x: r.change, y: r.pctRent, r: rScale(r.rent), _r: r}; });
        var bg = pts.map(function(r){ return r.danger ? 'rgba(220,53,69,0.75)' : 'rgba(23,162,184,0.72)'; });
        var bd = pts.map(function(r){ return r.danger ? '#b02a37' : '#117a8b'; });

        var xs = pts.map(function(r){ return r.change; });
        var xmin = Math.min.apply(null, xs.concat([0])), xmax = Math.max.apply(null, xs.concat([0]));
        var xpad = (xmax - xmin) * 0.12 || 5; xmin -= xpad; xmax += xpad;
        var maxPct = Math.max.apply(null, pts.map(function(r){ return r.pctRent; }).concat([DANGER_PCT + 2]));
        var ymax = Math.ceil(maxPct * 1.1);

        if (chart) chart.destroy();
        var ctx = document.getElementById('analysisChart').getContext('2d');
        chart = new Chart(ctx, {
            data: { datasets: [{ type: 'bubble', label: 'Properties', data: data, backgroundColor: bg, borderColor: bd, borderWidth: 1 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                layout: { padding: { top: 4, right: 6 } },
                scales: {
                    x: { min: xmin, max: xmax, title: {display: true, text: 'Rent change (%)'},
                         ticks: { callback: function(v){ return (v>0?'+':'') + v + '%'; } } },
                    y: { min: 0, max: ymax, title: {display: true, text: 'Actual expenses (% of rent)'},
                         ticks: { callback: function(v){ return v + '%'; } } }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function(c) {
                        var r = c.raw && c.raw._r; if (!r) return '';
                        return [r.name, 'Rent change: ' + (r.change==null?'—':pct(r.change)),
                                'Actual/rent: ' + r.pctRent.toFixed(1) + '%',
                                'Rent: ' + euro(r.rent) + '  Actual: ' + euro(r.actual)];
                    } } }
                }
            },
            plugins: [quadrantPlugin]
        });
    }

    function renderRanking(rows, year) {
        var rk = rows.filter(function(r){ return r.pctRent != null; }).slice().sort(function(a,b){ return b.pctRent - a.pctRent; });
        var labels = rk.map(function(r){ return r.name; });
        var vals = rk.map(function(r){ return +r.pctRent.toFixed(1); });
        var bg = rk.map(function(r){ return r.pctRent >= DANGER_PCT ? 'rgba(220,53,69,0.8)' : '#17a2b8'; });
        var wrap = document.querySelector('.analysis-chart-wrap');
        wrap.style.height = Math.max(240, rk.length * 30 + 50) + 'px';
        if (chart) chart.destroy();
        var ctx = document.getElementById('analysisChart').getContext('2d');
        chart = new Chart(ctx, {
            type: 'bar',
            data: { labels: labels, datasets: [{ label: 'Actual % of rent', data: vals, backgroundColor: bg, maxBarThickness: 22 }] },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                scales: { x: { beginAtZero: true, title: {display:true, text:'Actual expenses (% of rent) — ' + year}, ticks: { callback: function(v){ return v + '%'; } } } },
                plugins: { legend: { display:false }, tooltip: { callbacks: { label: function(c){ return c.parsed.x + '% of rent'; } } } }
            }
        });
    }

    function renderTable(rows, single) {
        var body = document.getElementById('analysisTableBody');
        body.innerHTML = '';
        rows.slice().sort(function(a,b){ return (b.pctRent||0) - (a.pctRent||0); }).forEach(function(r) {
            var tr = document.createElement('tr');
            if (r.danger) tr.className = 'danger-row';
            var chg = (r.change == null) ? '<span class="analysis-src">—</span>'
                     : ('<span style="color:' + (r.change < 0 ? '#dc3545' : '#1f7a37') + ';">' + pct(r.change) + '</span>');
            var pctCell = (r.pctRent == null) ? '—' : r.pctRent.toFixed(1) + '%';
            tr.innerHTML =
                '<td>' + escapeHtml(r.name) + ' <span class="analysis-src">(' + r.source + ')</span></td>' +
                '<td class="num">' + euro(r.rent) + '</td>' +
                '<td class="text-center">' + r.let + '/12</td>' +
                '<td class="num">' + euro(r.actual) + '</td>' +
                '<td class="num">' + pctCell + '</td>' +
                '<td class="num">' + chg + '</td>' +
                '<td class="text-center">' + (r.danger ? '<span class="analysis-flag warn">Watch</span>' : '<span class="analysis-flag ok">OK</span>') + '</td>';
            body.appendChild(tr);
        });
    }

    // Load on first open (vanilla listener — same reason as the Report modal).
    document.querySelectorAll('[data-target="#expenseAnalysisModal"]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!loaded) { loaded = true; load(); }
            else if (chart) { setTimeout(function(){ chart.resize(); }, 250); }
        });
    });
})();
</script>


{% endblock %}