<script>
(function() {
    'use strict';

    var REPORT_DATA_URL = "{% url 'act_expense_report_data' %}";
    var REPORT_PROP_URL = "{% url 'act_expense_report_property' %}";

    var chartInstance = null;
    var loaded = false;
    var currentRows = [];

    function euro(n) {
        return '\u20ac' + Number(n || 0).toLocaleString('en-IE', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    }

    function selectedYearsParam() {
        var all = document.getElementById('reportYearAll');
        if (all && all.checked) return 'all';
        var picked = [];
        document.querySelectorAll('#reportYearList input[type=checkbox]:checked').forEach(function(cb) {
            picked.push(cb.value);
        });
        return picked.length ? picked.join(',') : 'all';
    }

    function showOverview() {
        document.getElementById('reportDrill').style.display = 'none';
        document.getElementById('reportOverview').style.display = 'block';
    }

    function buildYearCheckboxes(years) {
        var list = document.getElementById('reportYearList');
        if (list.dataset.built === '1') return;
        list.innerHTML = '';
        years.forEach(function(y) {
            var lbl = document.createElement('label');
            lbl.className = 'report-year-chk';
            lbl.innerHTML = '<input type="checkbox" value="' + y + '"> ' + y;
            list.appendChild(lbl);
        });
        list.dataset.built = '1';

        var allCb = document.getElementById('reportYearAll');
        allCb.addEventListener('change', function() {
            if (allCb.checked) {
                list.querySelectorAll('input[type=checkbox]').forEach(function(cb){ cb.checked = false; });
            } else if (list.querySelectorAll('input[type=checkbox]:checked').length === 0) {
                allCb.checked = true;
                return;
            }
            loadData();
        });
        list.querySelectorAll('input[type=checkbox]').forEach(function(cb) {
            cb.addEventListener('change', function() {
                if (cb.checked) { allCb.checked = false; }
                if (list.querySelectorAll('input[type=checkbox]:checked').length === 0) { allCb.checked = true; }
                loadData();
            });
        });
    }

    function loadData() {
        var loading = document.getElementById('reportLoading');
        var empty = document.getElementById('reportEmpty');
        var content = document.getElementById('reportContent');
        loading.style.display = 'block';
        empty.style.display = 'none';
        content.style.display = 'none';
        showOverview();

        fetch(REPORT_DATA_URL + '?years=' + encodeURIComponent(selectedYearsParam()), {headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function(r){ return r.json(); })
            .then(function(data) {
                buildYearCheckboxes(data.available_years || []);
                currentRows = data.rows || [];
                loading.style.display = 'none';
                if (!currentRows.length) {
                    empty.style.display = 'block';
                    if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
                    document.getElementById('reportTableBody').innerHTML = '';
                    document.getElementById('reportGrandTotal').textContent = '';
                    return;
                }
                content.style.display = 'block';
                document.getElementById('reportGrandTotal').textContent = 'Total: ' + euro(data.grand_total);
                renderChart(currentRows);
                renderTable(currentRows);
            })
            .catch(function(err) {
                loading.innerHTML = '<span class="text-danger">Failed to load report.</span>';
                console.error('Report load error:', err);
            });
    }

    function renderChart(rows) {
            var wrap = document.querySelector('.report-chart-wrap');
            wrap.style.height = Math.max(160, rows.length * 30 + 40) + 'px';
            var isMobile = window.matchMedia('(max-width: 768px)').matches;

            var labels = rows.map(function (r) { return r.prop_name; });
            var values = rows.map(function (r) { return r.total; });

            if (chartInstance) { chartInstance.destroy(); }
            var ctx = document.getElementById('reportChart').getContext('2d');
            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Expenses',
                        data: values,
                        backgroundColor: '#17a2b8',
                        borderColor: '#117a8b',
                        borderWidth: 1,
                        maxBarThickness: 22
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { right: isMobile ? 6 : 12 } },
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: function (c) { return euro(c.parsed.x); } } }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                maxTicksLimit: isMobile ? 4 : 8,
                                font: { size: isMobile ? 10 : 12 },
                                callback: function (v) {
                                    if (isMobile && Math.abs(v) >= 1000) {
                                        var k = v / 1000;
                                        return '\u20ac' + (k % 1 === 0 ? k : k.toFixed(1)) + 'k';
                                    }
                                    return euro(v);
                                }
                            }
                        },
                        y: {
                            ticks: {
                                font: { size: isMobile ? 10 : 12 },
                                callback: function (value, index) {
                                    var label = labels[index] != null ? String(labels[index]) : '';
                                    if (isMobile && label.length > 16) { return label.slice(0, 15) + '\u2026'; }
                                    return label;
                                }
                            }
                        }
                    },
                    onClick: function (evt, elements) {
                        if (elements && elements.length) {
                            var row = rows[elements[0].index];
                            if (row) { openDrill(row.prop_id, row.prop_name); }
                        }
                    }
                }
            });
        }

    function renderTable(rows) {
        var body = document.getElementById('reportTableBody');
        body.innerHTML = '';
        rows.forEach(function(r) {
            var tr = document.createElement('tr');
            tr.innerHTML = '<td>' + escapeHtml(r.prop_name) + '</td><td class="text-right">' + euro(r.total) + '</td><td class="text-center">' + r.count + '</td>';
            tr.addEventListener('click', function(){ openDrill(r.prop_id, r.prop_name); });
            body.appendChild(tr);
        });
    }

    function openDrill(propId, propName) {
        document.getElementById('reportDrillTitle').textContent = propName;
        document.getElementById('reportDrillBody').innerHTML = '<tr><td colspan="6" class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>';
        document.getElementById('reportDrillTotal').textContent = '';
        document.getElementById('reportOverview').style.display = 'none';
        document.getElementById('reportDrill').style.display = 'block';

        fetch(REPORT_PROP_URL + '?prop=' + encodeURIComponent(propId) + '&years=' + encodeURIComponent(selectedYearsParam()), {headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function(r){ return r.json(); })
            .then(function(data) {
                var body = document.getElementById('reportDrillBody');
                body.innerHTML = '';
                if (!data.rows || !data.rows.length) {
                    body.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No expenses for this property in the selected year(s).</td></tr>';
                } else {
                    data.rows.forEach(function(e) {
                        var inv = e.doc_url
                            ? '<i class="fas fa-file-alt report-invoice-icon" title="View invoice" onclick="reportViewInvoice(\'' + e.doc_url + '\', \'' + (e.doc_name || 'invoice') + '\')"></i>'
                            : '<span class="report-invoice-none">\u2014</span>';
                        var tr = document.createElement('tr');
                        tr.innerHTML =
                            '<td data-label="Date">' + e.date + '</td>' +
                            '<td data-label="Description">' + escapeHtml(e.description) + '</td>' +
                            '<td data-label="Amount" class="text-right">' + euro(e.amount) + '</td>' +
                            '<td data-label="Approved" class="text-center">' + statusBadge(e.approved) + '</td>' +
                            '<td data-label="Paid" class="text-center">' + statusBadge(e.paid) + '</td>' +
                            '<td data-label="Invoice" class="text-center">' + inv + '</td>';
                        body.appendChild(tr);
                    });
                }
                document.getElementById('reportDrillTotal').textContent = 'Total: ' + euro(data.total);
            })
            .catch(function(err) {
                document.getElementById('reportDrillBody').innerHTML = '<tr><td colspan="6" class="text-center text-danger">Failed to load.</td></tr>';
                console.error('Drill load error:', err);
            });
    }

    function statusBadge(v) {
        var yes = (v === 'Yes');
        return '<span style="color:' + (yes ? '#28a745' : '#dc3545') + ';font-weight:600;">' + (yes ? 'Yes' : 'No') + '</span>';
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    window.reportViewInvoice = function(url, name) {
        if (typeof openPdfViewer === 'function') {
            openPdfViewer(url, 'Expense Invoice', (name || '').split('/').pop() || 'invoice');
        } else {
            window.open(url, '_blank');
        }
    };

    document.getElementById('reportDrillBack').addEventListener('click', showOverview);

    // Trigger the load on the click that opens the modal, in vanilla JS rather
    // than via Bootstrap's 'shown.bs.modal'. This page loads jQuery twice (base
    // template + this template), and Bootstrap's modal events fire on a different
    // jQuery instance than an inline handler binds to — so the event never lands.
    document.querySelectorAll('[data-target="#expenseReportModal"]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!loaded) {
                loaded = true;
                loadData();
            } else if (chartInstance) {
                setTimeout(function() { chartInstance.resize(); }, 250);
            }
        });
    });
})();
</script>


