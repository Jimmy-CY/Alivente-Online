<!-- Standard PDF Viewer component (powers both quick-view tap on the table icon
     and the "View Document" launcher inside the Manage modal Invoice tab) -->
{% include 'components/pdf_viewer.html' %}

{% render_help_modal "expenses" %}

<!-- JavaScript -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Filter panel — start collapsed unless there's an active filter
    const filterContent = document.getElementById('filterContent');
    const toggleIcon = document.getElementById('filterToggleIcon');

    if (filterContent && toggleIcon) {
        filterContent.classList.remove('expanded');
        toggleIcon.style.transform = 'rotate(0deg)';
    }

    // Auto-submit on filter change
    ['propertySelect', 'statusSelect', 'fromDateInput', 'toDateInput'].forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            element.addEventListener('change', function() {
                sessionStorage.setItem('userInteracted', 'true');
                sessionStorage.setItem('justUsedDropdown', 'true');
                expandFilterPanel();
                document.getElementById('filterForm').submit();
            });
        }
    });

    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sessionStorage.setItem('userInteracted', 'true');
                expandFilterPanel();
                document.getElementById('filterForm').submit();
            }
        });
    }

    const searchBtn = document.getElementById('searchBtn');
    if (searchBtn) {
        searchBtn.addEventListener('click', function() {
            sessionStorage.setItem('userInteracted', 'true');
            expandFilterPanel();
            document.getElementById('filterForm').submit();
        });
    }

    updateActiveFilters();

    // Auto-expand filter panel when there are active filters from any source
    // (deep link, page refresh after filter use, etc.) — so the user sees
    // why their list is filtered and can clear it.
    const userHasInteracted = sessionStorage.getItem('userInteracted') === 'true';
    const hasActiveFilters = checkForActiveFilters();
    const justClearedFilters = sessionStorage.getItem('justClearedFilters') === 'true';
    const justUsedDropdown = sessionStorage.getItem('justUsedDropdown') === 'true';

    if (hasActiveFilters || justClearedFilters || justUsedDropdown) {
        setTimeout(() => { expandFilterPanel(); }, 100);
    }

    if (justClearedFilters) setTimeout(() => sessionStorage.removeItem('justClearedFilters'), 200);
    if (justUsedDropdown) setTimeout(() => sessionStorage.removeItem('justUsedDropdown'), 200);

    // Mobile-only More menu wiring
    initializeMoreMenu();
});

// Mobile-only "More" actions dropdown
function initializeMoreMenu() {
    const moreBtn = document.getElementById('actionMoreBtn');
    const moreMenu = document.getElementById('actionMoreMenu');
    if (!moreBtn || !moreMenu) return;

    function closeMenu() {
        moreMenu.setAttribute('hidden', '');
        moreBtn.setAttribute('aria-expanded', 'false');
    }
    function openMenu() {
        moreMenu.removeAttribute('hidden');
        moreBtn.setAttribute('aria-expanded', 'true');
    }
    moreBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = !moreMenu.hasAttribute('hidden');
        if (isOpen) closeMenu(); else openMenu();
    });
    document.addEventListener('click', function(e) {
        if (!moreBtn.contains(e.target) && !moreMenu.contains(e.target)) closeMenu();
    });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !moreMenu.hasAttribute('hidden')) {
            closeMenu();
            moreBtn.focus();
        }
    });
    moreMenu.querySelectorAll('.action-more-item').forEach(item => {
        item.addEventListener('click', function() { closeMenu(); });
    });
}

function checkForActiveFilters() {
    const searchInput = document.getElementById('searchInput');
    const propertySelect = document.getElementById('propertySelect');
    const statusSelect = document.getElementById('statusSelect');
    const fromDateInput = document.getElementById('fromDateInput');
    const toDateInput = document.getElementById('toDateInput');

    return (searchInput && searchInput.value) ||
           (propertySelect && propertySelect.value) ||
           (statusSelect && statusSelect.value) ||
           (fromDateInput && fromDateInput.value) ||
           (toDateInput && toDateInput.value);
}

function expandFilterPanel() {
    const filterContent = document.getElementById('filterContent');
    const toggleIcon = document.getElementById('filterToggleIcon');
    if (filterContent && toggleIcon) {
        filterContent.classList.add('expanded');
        toggleIcon.style.transform = 'rotate(180deg)';
    }
}

function toggleFilterPanel() {
    const filterContent = document.getElementById('filterContent');
    const toggleIcon = document.getElementById('filterToggleIcon');

    if (filterContent.classList.contains('expanded')) {
        filterContent.classList.remove('expanded');
        toggleIcon.style.transform = 'rotate(0deg)';
        sessionStorage.setItem('userInteracted', 'false');
    } else {
        filterContent.classList.add('expanded');
        toggleIcon.style.transform = 'rotate(180deg)';
        sessionStorage.setItem('userInteracted', 'true');
    }
}

function clearAllFilters(event) {
    event.stopPropagation();
    sessionStorage.setItem('userInteracted', 'true');
    sessionStorage.setItem('justClearedFilters', 'true');
    expandFilterPanel();
    document.getElementById('searchInput').value = '';
    document.getElementById('propertySelect').value = '';
    document.getElementById('statusSelect').value = '';
    document.getElementById('fromDateInput').value = '';
    document.getElementById('toDateInput').value = '';
    document.getElementById('filterForm').submit();
}

function clearFilter(filterType) {
    sessionStorage.setItem('userInteracted', 'true');
    sessionStorage.setItem('justClearedFilters', 'true');
    expandFilterPanel();
    switch(filterType) {
        case 'search': document.getElementById('searchInput').value = ''; break;
        case 'property': document.getElementById('propertySelect').value = ''; break;
        case 'status': document.getElementById('statusSelect').value = ''; break;
        case 'from_date': document.getElementById('fromDateInput').value = ''; break;
        case 'to_date': document.getElementById('toDateInput').value = ''; break;
    }
    document.getElementById('filterForm').submit();
}

function updateActiveFilters() {
    const searchInput = document.getElementById('searchInput');
    const propertySelect = document.getElementById('propertySelect');
    const statusSelect = document.getElementById('statusSelect');
    const fromDateInput = document.getElementById('fromDateInput');
    const toDateInput = document.getElementById('toDateInput');
    const activeFiltersDiv = document.getElementById('activeFilters');
    const filterTagsDiv = document.getElementById('filterTags');

    if (!filterTagsDiv) return;

    filterTagsDiv.innerHTML = '';
    let hasFilters = false;

    if (searchInput.value) {
        filterTagsDiv.innerHTML += `<span class="filter-tag">Search: "${searchInput.value}" <button class="remove-tag" onclick="clearFilter('search')" type="button">×</button></span>`;
        hasFilters = true;
    }
    if (propertySelect.value) {
        const text = propertySelect.options[propertySelect.selectedIndex].text;
        filterTagsDiv.innerHTML += `<span class="filter-tag">Property: ${text} <button class="remove-tag" onclick="clearFilter('property')" type="button">×</button></span>`;
        hasFilters = true;
    }
    if (statusSelect.value) {
        const text = statusSelect.options[statusSelect.selectedIndex].text;
        filterTagsDiv.innerHTML += `<span class="filter-tag">Status: ${text} <button class="remove-tag" onclick="clearFilter('status')" type="button">×</button></span>`;
        hasFilters = true;
    }
    if (fromDateInput.value) {
        filterTagsDiv.innerHTML += `<span class="filter-tag">From: ${fromDateInput.value} <button class="remove-tag" onclick="clearFilter('from_date')" type="button">×</button></span>`;
        hasFilters = true;
    }
    if (toDateInput.value) {
        filterTagsDiv.innerHTML += `<span class="filter-tag">To: ${toDateInput.value} <button class="remove-tag" onclick="clearFilter('to_date')" type="button">×</button></span>`;
        hasFilters = true;
    }

    activeFiltersDiv.style.display = hasFilters ? 'flex' : 'none';
}

// Auto-dismiss alerts
setTimeout(function() {
    document.querySelectorAll('.auto-dismiss').forEach(alert => {
        alert.classList.remove('show');
        alert.classList.add('fade');
        setTimeout(() => alert.remove(), 500);
    });
}, 2000);

// ==================== MANAGE MODAL ====================
let currentExpenseId = null;

function openManageModal(expenseId, date, property, description, amount, approved, paid, documentUrl, documentName, isSuperuser, canEditExpenses) {
    currentExpenseId = expenseId;

    const canEdit = isSuperuser || (canEditExpenses && approved === 'No' && paid === 'No');
    const canDelete = canEdit;
    const canManageDocuments = isSuperuser || canEditExpenses;

    populateExpenseDetailsTab(expenseId, date, property, description, amount, approved, paid, canEdit, isSuperuser);
    populateInvoiceTab(documentUrl, documentName, expenseId, canManageDocuments);

    const deleteTabNav = document.getElementById('delete-tab-nav');
    if (canDelete) {
        deleteTabNav.style.display = 'block';
        document.getElementById('deleteExpenseDetails').innerHTML = `
            <p><strong>Date:</strong> ${date}</p>
            <p><strong>Property:</strong> ${property}</p>
            <p><strong>Description:</strong> ${description}</p>
            <p><strong>Amount:</strong> €${amount}</p>
        `;
        document.getElementById('delete_expense_id').value = expenseId;
    } else {
        deleteTabNav.style.display = 'none';
        if (document.getElementById('delete-tab').classList.contains('active')) {
            document.getElementById('expense-tab').click();
        }
    }

    document.getElementById('deleteConfirmation').checked = false;
    document.getElementById('confirmDeleteBtn').disabled = true;

    $('#manageModal').modal('show');
}

function populateExpenseDetailsTab(expenseId, date, property, description, amount, approved, paid, canEdit, isSuperuser) {
    const expenseDetailsContent = document.getElementById('expenseDetailsContent');

    if (canEdit) {
        const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]').value;

        expenseDetailsContent.innerHTML = `
            <form id="expenseEditForm" method="post">
              <input type="hidden" name="csrfmiddlewaretoken" value="${csrfToken}">
              <input type="hidden" id="edit_expense_id" name="expense_id" value="${expenseId}">
              <input type="hidden" name="action" value="edit">

              <div class="form-row">
                <div class="form-group col-md-3">
                  <label for="edit_expense_date"><strong>Expense Date</strong></label>
                  <input type="date" id="edit_expense_date" class="form-control" name="act_expense_date" value="${date}" required>
                </div>
                <div class="form-group col-md-4">
                  <label for="edit_prop"><strong>Property Name</strong></label>
                  <select id="edit_prop" class="form-control" name="prop" required>
                    {% for prop in props %}
                      <option value="{{ prop.prop_id }}">{{ prop.prop_name }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="form-group col-md-5">
                  <label for="edit_expense_description"><strong>Expense Description</strong></label>
                  <input type="text" class="form-control" id="edit_expense_description" name="act_expense_description" maxlength="55" value="${description}" required>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group col-md-3">
                  <label for="edit_expense_amount"><strong>Amount</strong></label>
                  <input type="number" class="form-control" id="edit_expense_amount" name="act_expense_amount" step="0.01" value="${amount}" required>
                </div>
                ${isSuperuser ? `
                <div class="form-group col-md-3">
                  <label for="edit_expense_approved"><strong>Approved ?</strong></label>
                  <select id="edit_expense_approved" class="form-control" name="act_expense_approved" required>
                    <option value="Yes" ${approved === 'Yes' ? 'selected' : ''}>Yes</option>
                    <option value="No" ${approved === 'No' ? 'selected' : ''}>No</option>
                  </select>
                </div>
                <div class="form-group col-md-3">
                  <label for="edit_expense_paid"><strong>Paid ?</strong></label>
                  <select id="edit_expense_paid" class="form-control" name="act_expense_paid" required>
                    <option value="Yes" ${paid === 'Yes' ? 'selected' : ''}>Yes</option>
                    <option value="No" ${paid === 'No' ? 'selected' : ''}>No</option>
                  </select>
                </div>` : ''}
              </div>
              <div class="text-right">
                <button type="submit" class="btn btn-success">Save Changes</button>
              </div>
            </form>
        `;

        const propSelect = document.getElementById('edit_prop');
        if (propSelect) {
            for (let option of propSelect.options) {
                if (option.text === property) { option.selected = true; break; }
            }
        }

        const approvedSelect = document.getElementById('edit_expense_approved');
        const paidSelect = document.getElementById('edit_expense_paid');

        if (approvedSelect && paidSelect) {
            const hiddenPaidInput = document.createElement('input');
            hiddenPaidInput.type = 'hidden';
            hiddenPaidInput.name = 'act_expense_paid_hidden';
            hiddenPaidInput.id = 'edit_expense_paid_hidden';
            paidSelect.parentNode.appendChild(hiddenPaidInput);

            function updatePaidFieldStatus() {
                const isApproved = approvedSelect.value === 'Yes';
                if (!isApproved) {
                    paidSelect.value = 'No';
                    paidSelect.disabled = true;
                    paidSelect.style.opacity = '0.5';
                    paidSelect.style.cursor = 'not-allowed';
                    hiddenPaidInput.value = 'No';
                } else {
                    paidSelect.disabled = false;
                    paidSelect.style.opacity = '1';
                    paidSelect.style.cursor = 'pointer';
                    hiddenPaidInput.value = paidSelect.value;
                }
            }

            updatePaidFieldStatus();
            approvedSelect.addEventListener('change', updatePaidFieldStatus);
            paidSelect.addEventListener('change', function() {
                hiddenPaidInput.value = this.value;
            });
        }
    } else {
        expenseDetailsContent.innerHTML = `
            <div class="alert alert-warning">
                <i class="fas fa-lock"></i> <strong>Read Only:</strong> This expense cannot be modified.
            </div>
            <div class="form-row">
                <div class="form-group col-md-3">
                  <label><strong>Expense Date</strong></label>
                  <div class="form-control-plaintext">${date}</div>
                </div>
                <div class="form-group col-md-4">
                  <label><strong>Property Name</strong></label>
                  <div class="form-control-plaintext">${property}</div>
                </div>
                <div class="form-group col-md-5">
                  <label><strong>Expense Description</strong></label>
                  <div class="form-control-plaintext">${description}</div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group col-md-3">
                  <label><strong>Amount</strong></label>
                  <div class="form-control-plaintext">€${amount}</div>
                </div>
                <div class="form-group col-md-3">
                  <label><strong>Approved</strong></label>
                  <div class="form-control-plaintext">
                    <span class="badge badge-${approved === 'Yes' ? 'success' : 'warning'}">${approved}</span>
                  </div>
                </div>
                <div class="form-group col-md-3">
                  <label><strong>Paid</strong></label>
                  <div class="form-control-plaintext">
                    <span class="badge badge-${paid === 'Yes' ? 'success' : 'warning'}">${paid}</span>
                  </div>
                </div>
              </div>
        `;
    }
}

function populateInvoiceTab(documentUrl, documentName, expenseId, canManageDocuments) {
    const invoiceContent = document.getElementById('invoiceContent');
    const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]').value;

    // Build the document launcher card (used when a document exists)
    function launcherCard(name) {
        const cleanName = (name || '').split('/').pop() || 'document';
        return `
            <div class="doc-launcher-card">
                <div class="doc-launcher-icon"><i class="fas fa-file-invoice"></i></div>
                <div class="doc-launcher-name">${cleanName}</div>
                <button type="button" class="doc-launcher-btn" onclick="openExpenseDocument('${documentUrl}', '${cleanName}')">
                    <i class="fas fa-eye"></i> View Document
                </button>
            </div>
        `;
    }

    // ====== Read-only branch ======
    if (!canManageDocuments) {
        if (documentUrl && documentName) {
            invoiceContent.innerHTML = `
                <div class="alert alert-info">
                    <i class="fas fa-eye"></i> <strong>Read Only:</strong> You can view this document but cannot modify it.
                </div>
                ${launcherCard(documentName)}
            `;
        } else {
            invoiceContent.innerHTML = `
                <div class="alert alert-info">
                    <i class="fas fa-eye"></i> <strong>Read Only:</strong> You do not have permission to manage documents.
                </div>
                <p class="text-muted">No invoice document is attached to this expense.</p>
            `;
        }
        return;
    }

    // ====== Edit branch (superusers + edit users) ======
    if (documentUrl && documentName) {
        const cleanName = documentName.split('/').pop();
        const extension = cleanName.split('.').pop().toLowerCase();
        const isPdf = extension === 'pdf';

        // "Add to Existing" merge button only makes sense for PDFs
        const addToExistingBtn = isPdf ? `
            <button type="button" class="btn btn-success btn-sm" onclick="showAddToExisting()">
                <i class="fas fa-plus"></i> Add to Existing
            </button>
        ` : '';

        invoiceContent.innerHTML = `
            ${launcherCard(documentName)}

            <div class="doc-action-row">
                <a href="${documentUrl}" download="${cleanName}" class="btn btn-info btn-sm">
                    <i class="fas fa-download"></i> Download
                </a>
                ${addToExistingBtn}
                <button type="button" class="btn btn-warning btn-sm" onclick="showReplaceUpload()">
                    <i class="fas fa-sync"></i> Replace
                </button>
                <button type="button" class="btn btn-danger btn-sm" onclick="deleteInvoiceDocument(${expenseId})">
                    <i class="fas fa-trash"></i> Delete Document
                </button>
            </div>

            <div id="addToExistingForm" style="display: none;" class="mt-3 bg-light p-3 border rounded">
                <h6 class="text-success"><i class="fas fa-plus-circle"></i> Add to Existing PDF</h6>
                <form method="post" enctype="multipart/form-data" id="addToExistingDocumentForm">
                    <input type="hidden" name="csrfmiddlewaretoken" value="${csrfToken}">
                    <input type="hidden" name="expense_id" value="${expenseId}">
                    <input type="hidden" name="action" value="upload">
                    <input type="hidden" name="document_action" value="add_to_existing">
                    <div class="form-group">
                        <label>Select Document to Merge:</label>
                        <input type="file" class="form-control-file" name="act_expense_document" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx" required>
                        <small class="form-text text-success"><i class="fas fa-info-circle"></i> All file types will be converted to PDF and merged. Max file size: 5MB</small>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-plus"></i> Merge Documents</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="hideAddToExisting()">Cancel</button>
                </form>
            </div>

            <div id="replaceUploadForm" style="display: none;" class="mt-3">
                <form method="post" enctype="multipart/form-data" id="replaceDocumentForm">
                    <input type="hidden" name="csrfmiddlewaretoken" value="${csrfToken}">
                    <input type="hidden" name="expense_id" value="${expenseId}">
                    <input type="hidden" name="action" value="upload">
                    <div class="form-group">
                        <label>Select New Document:</label>
                        <input type="file" class="form-control-file" name="act_expense_document" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx" required>
                        <small class="form-text text-muted">Max file size: 5MB</small>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm">Upload</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="hideReplaceUpload()">Cancel</button>
                </form>
            </div>
        `;
    } else {
        invoiceContent.innerHTML = `
            <h6>No Invoice Document Attached</h6>
            <p class="text-muted">Upload an invoice document for this expense.</p>
            <form method="post" enctype="multipart/form-data" id="uploadDocumentForm">
                <input type="hidden" name="csrfmiddlewaretoken" value="${csrfToken}">
                <input type="hidden" name="expense_id" value="${expenseId}">
                <input type="hidden" name="action" value="upload">
                <div class="form-group">
                    <label>Select Document (PDF, JPG, PNG, Excel, Word):</label>
                    <input type="file" class="form-control-file" name="act_expense_document" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx" required>
                    <small class="form-text text-muted">Max file size: 5MB</small>
                </div>
                <button type="submit" class="btn btn-info">
                    <i class="fas fa-upload"></i> Upload Document
                </button>
            </form>
        `;
    }
}

function showAddToExisting() {
    document.getElementById('addToExistingForm').style.display = 'block';
    document.getElementById('replaceUploadForm').style.display = 'none';
}
function hideAddToExisting() {
    document.getElementById('addToExistingForm').style.display = 'none';
}
function showReplaceUpload() {
    document.getElementById('replaceUploadForm').style.display = 'block';
    document.getElementById('addToExistingForm').style.display = 'none';
}
function hideReplaceUpload() {
    document.getElementById('replaceUploadForm').style.display = 'none';
}

function deleteInvoiceDocument(expenseId) {
    if (confirm('Are you sure you want to delete this invoice document?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '{% url "act_expense_manage_document" %}';

        const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]').value;
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'csrfmiddlewaretoken';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);

        const expenseInput = document.createElement('input');
        expenseInput.type = 'hidden';
        expenseInput.name = 'expense_id';
        expenseInput.value = expenseId;
        form.appendChild(expenseInput);

        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = 'delete_document';
        form.appendChild(actionInput);

        document.body.appendChild(form);
        form.submit();
    }
}

