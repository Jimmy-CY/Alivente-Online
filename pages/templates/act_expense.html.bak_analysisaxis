<script>
(function() {
    'use strict';
    var ANALYSIS_URL = "{% url 'act_expense_analysis_data' %}";
    var PALETTE = ['#17a2b8','#e8590c','#2f9e44','#7048e8','#1c7ed6','#e64980','#f08c00','#0ca678','#5c7cfa','#d6336c','#c2255c','#495057'];
    var DANGER_PCT = 10, X_DIV = 0, X_CAP = 50;
    var chart = null, loaded = false, DATA = null;
    var labelHitboxes = [], canvasHandler = null;
    var state = { year: null, from: null, to: null, history: false };

    function rgba(hex, a){ var n = parseInt(hex.slice(1),16); return 'rgba('+((n>>16)&255)+','+((n>>8)&255)+','+(n&255)+','+a+')'; }
    function euro(n){ return '€' + Number(n||0).toLocaleString('en-IE', {maximumFractionDigits:0}); }
    function pctTxt(n){ return (n>0?'+':'') + Number(n).toFixed(1) + '%'; }
    function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function ascYears(){ return (DATA.available_years||[]).slice().sort(function(a,b){ return a-b; }); }
    function clampX(v){ return Math.max(-X_CAP, Math.min(X_CAP, v)); }

    function focusYear(){ return state.history ? state.to : state.year; }
    function ytdActive(){ return DATA.ytd_cutoff_month >= 1 && focusYear() === DATA.current_year; }

    function yv(p, y){
        var d = p.years[String(y)];
        if (!d) return null;
        return ytdActive()
            ? { rent:d.rent_ytd, actual:d.actual_ytd, let:d.months_let_ytd, source:d.source }
            : { rent:d.rent, actual:d.actual, let:d.months_let, source:d.source };
    }
    function pointFor(p, y){
        var cur = yv(p, y); if (!cur) return null;
        var prev = yv(p, y-1);
        var change = (prev && prev.rent) ? ((cur.rent - prev.rent)/prev.rent*100) : null;
        var pr = cur.rent ? (cur.actual/cur.rent*100) : null;
        return { x:change, y:pr, year:y, rent:cur.rent, actual:cur.actual, let:cur.let,
                 source:cur.source, name:p.prop_name,
                 danger: (pr!=null && pr>=DANGER_PCT && (change==null || change<=0)) };
    }
    function plottedYears(){
        if (!state.history) return [state.year];
        return ascYears().filter(function(y){ return y >= state.from && y <= state.to; });
    }
    // rent-change axis cap: fit the bulk so one new-lease outlier can't flatten
    // everyone. Walk down the sorted |change| values and drop any that jump far
    // above the next (a >2.5x leap past 40%); pin those to the edge. Robust for
    // any number of properties.
    function computeCap(){
        var vals=[], years=plottedYears();
        (DATA.properties||[]).forEach(function(p){ years.forEach(function(y){ var pt=pointFor(p,y); if(pt&&pt.x!=null && isFinite(pt.x)) vals.push(Math.abs(pt.x)); }); });
        vals.sort(function(a,b){ return a-b; });
        if(!vals.length){ X_CAP=10; return; }
        var cap=vals[vals.length-1];
        for(var i=vals.length-1; i>=1; i--){
            if(vals[i] > Math.max(40, vals[i-1]*2.5)) cap=vals[i-1];
            else break;
        }
        X_CAP = Math.max(10, cap*1.3);
    }

    var quadrantPlugin = {
        id:'quads',
        beforeDatasetsDraw:function(c){
            var xs=c.scales.x, ys=c.scales.y, a=c.chartArea, ctx=c.ctx; if(!xs||!ys||!a) return;
            var x0=Math.max(a.left,Math.min(a.right,xs.getPixelForValue(X_DIV)));
            var y10=Math.max(a.top,Math.min(a.bottom,ys.getPixelForValue(DANGER_PCT)));
            ctx.save(); ctx.globalAlpha=0.32;
            ctx.fillStyle='#ffd7d7'; ctx.fillRect(a.left,a.top,x0-a.left,y10-a.top);
            ctx.fillStyle='#ffe8cc'; ctx.fillRect(x0,a.top,a.right-x0,y10-a.top);
            ctx.fillStyle='#e7f5ff'; ctx.fillRect(a.left,y10,x0-a.left,a.bottom-y10);
            ctx.fillStyle='#d3f9d8'; ctx.fillRect(x0,y10,a.right-x0,a.bottom-y10);
            ctx.globalAlpha=1;
            ctx.setLineDash([5,4]); ctx.lineWidth=1; ctx.strokeStyle='rgba(0,0,0,0.28)';
            ctx.beginPath(); ctx.moveTo(x0,a.top); ctx.lineTo(x0,a.bottom); ctx.stroke();
            ctx.strokeStyle='#dc3545';
            ctx.beginPath(); ctx.moveTo(a.left,y10); ctx.lineTo(a.right,y10); ctx.stroke();
            ctx.setLineDash([]);
            ctx.font='700 11px system-ui,sans-serif'; ctx.textBaseline='top';
            ctx.fillStyle='rgba(201,42,42,.78)'; ctx.textAlign='left'; ctx.fillText('WATCH', a.left+6, a.top+5);
            ctx.fillStyle='rgba(232,89,12,.8)'; ctx.textAlign='right'; ctx.fillText('COSTS HIGH · RENT RISING', a.right-6, a.top+5);
            ctx.textBaseline='bottom';
            ctx.fillStyle='rgba(25,113,194,.8)'; ctx.textAlign='left'; ctx.fillText('RENT STALLED', a.left+6, a.bottom-5);
            ctx.fillStyle='rgba(47,158,68,.85)'; ctx.textAlign='right'; ctx.fillText('HEALTHY', a.right-6, a.bottom-5);
            ctx.restore();
        }
    };
    // Every property gets a visible label. When points pile up (e.g. several at
    // the origin), labels are nudged vertically and joined to their dot by a
    // thin leader line, rather than hidden. Pinned outliers show their real value.
    var labelPlugin = {
        id:'names',
        afterDatasetsDraw:function(c){
            var ctx=c.ctx, area=c.chartArea; ctx.save();
            ctx.font='600 11px system-ui,sans-serif'; ctx.textBaseline='middle';
            labelHitboxes = [];
            var items=[];
            c.data.datasets.forEach(function(ds,i){
                var m=c.getDatasetMeta(i); if(!m.data.length||ds._hide) return;
                var last=m.data[m.data.length-1];
                items.push({ ds:ds, px:last.x, py:last.y, di:i });
            });
            items.sort(function(a,b){ return a.py-b.py; });
            var placed=[];
            function free(rect){ return !placed.some(function(r){ return !(rect.x>r.x+r.w || rect.x+rect.w<r.x || rect.y>r.y+r.h || rect.y+rect.h<r.y); }); }
            items.forEach(function(it){
                var nm=it.ds.label; if(nm.length>20) nm=nm.slice(0,19)+'…';
                if(it.ds._pinDir!==0){ nm = nm + '  ' + (it.ds._pinVal>0?'+':'') + Math.round(it.ds._pinVal) + '%'; }
                var tw=ctx.measureText(nm).width;
                var rightSide = it.px <= area.right-(tw+24);
                var baseLx = rightSide ? (it.px+12) : (it.px-12-tw);
                baseLx = Math.max(area.left+2, Math.min(area.right-2-tw, baseLx));
                // candidate positions: stack vertically next to the dot, then fan
                // outward into open space so every label finds a home.
                var cands=[];
                for(var k=0;k<=16;k++){ cands.push([baseLx, it.py+k*14]); if(k) cands.push([baseLx, it.py-k*14]); }
                for(var dx=70; it.px+dx+tw <= area.right-2; dx+=80){
                    for(var j=0;j<=12;j++){ cands.push([it.px+dx, it.py+j*16]); if(j) cands.push([it.px+dx, it.py-j*16]); }
                }
                var chosen=null;
                for(var ci=0; ci<cands.length; ci++){
                    var lx=cands[ci][0], ly=cands[ci][1];
                    if(ly<area.top+8 || ly>area.bottom-8) continue;
                    if(lx<area.left+2 || lx+tw>area.right-2) continue;
                    var rect={ x:lx-2, y:ly-8, w:tw+4, h:16 };
                    if(free(rect)){ chosen={lx:lx, ly:ly, rect:rect}; break; }
                }
                if(!chosen) return;
                placed.push(chosen.rect);
                labelHitboxes.push({ x:chosen.rect.x, y:chosen.rect.y, w:chosen.rect.w, h:chosen.rect.h, di:it.di });
                if(Math.abs(chosen.ly-it.py)>3 || Math.abs(chosen.lx-(rightSide?it.px+12:it.px-12-tw))>3){
                    ctx.strokeStyle='rgba(120,120,120,0.6)'; ctx.lineWidth=0.75; ctx.setLineDash([2,3]);
                    var anchorX = (chosen.lx >= it.px) ? chosen.lx : (chosen.lx+tw);
                    ctx.beginPath(); ctx.moveTo(it.px, it.py); ctx.lineTo(anchorX, chosen.ly); ctx.stroke();
                    ctx.setLineDash([]);
                }
                ctx.fillStyle=it.ds._base||'#333';
                ctx.textAlign='left';
                ctx.fillText(nm, chosen.lx, chosen.ly);
            });
            ctx.restore();
        }
    };

    function buildDatasets(){
        var years = plottedYears();
        return (DATA.properties||[]).map(function(p, idx){
            var col = PALETTE[idx % PALETTE.length];
            var pts = years.map(function(y){ return pointFor(p, y); })
                           .filter(function(pt){ return pt && pt.x!=null && pt.y!=null; });
            if (!pts.length) return { label:p.prop_name, _base:col, _hide:true, _pinDir:0, data:[] };
            var n = pts.length;
            var last = pts[n-1];
            var pinDir = (Math.abs(last.x) > X_CAP) ? (last.x>0?1:-1) : 0;
            if (state.history && n>1){
                return {
                    label:p.prop_name, _base:col, _pinDir:pinDir, _pinVal:(pinDir!==0?last.x:0),
                    data: pts.map(function(pt){ return {x:clampX(pt.x), y:pt.y, _p:pt}; }),
                    showLine:true, tension:0.35, fill:false,
                    borderColor: rgba(col,0.45), borderWidth:1.5,
                    pointBackgroundColor: pts.map(function(_,i){ return rgba(col, 0.25+0.75*(i/(n-1))); }),
                    pointBorderColor: pts.map(function(_,i){ return i===n-1?'#fff':rgba(col,0.3); }),
                    pointBorderWidth: pts.map(function(_,i){ return i===n-1?2:1; }),
                    pointRadius: pts.map(function(_,i){ return 3+5*(i/(n-1)); }),
                    pointHoverRadius: 9
                };
            }
            return {
                label:p.prop_name, _base:col, _pinDir:pinDir, _pinVal:(pinDir!==0?last.x:0),
                data:[{x:clampX(last.x), y:last.y, _p:last}], showLine:false,
                pointBackgroundColor: last.danger ? '#dc3545' : col,
                pointBorderColor:'#fff', pointBorderWidth:2, pointRadius:8, pointHoverRadius:10
            };
        });
    }

    function axisBounds(){
        var xs=[0], ys=[DANGER_PCT+2];
        var years = plottedYears();
        (DATA.properties||[]).forEach(function(p){
            years.forEach(function(y){
                var pt=pointFor(p,y); if(pt&&pt.x!=null) xs.push(clampX(pt.x)); if(pt&&pt.y!=null) ys.push(pt.y);
            });
        });
        var xmin=Math.min.apply(null,xs), xmax=Math.max.apply(null,xs);
        var xpad=(xmax-xmin)*0.14 || 5; xmin-=xpad; xmax+=xpad;
        xmin=Math.floor(xmin); xmax=Math.ceil(xmax);
        if (xmax-xmin < 4){ var cc=(xmax+xmin)/2; xmin=Math.floor(cc-2); xmax=Math.ceil(cc+2); }
        var ymax=Math.ceil(Math.max.apply(null,ys)*1.12);
        var xstep=Math.max(1, Math.ceil((xmax-xmin)/8));
        var ystep=Math.max(1, Math.ceil(ymax/7));
        return { xmin:xmin, xmax:xmax, ymax:ymax, xstep:xstep, ystep:ystep };
    }

    function renderChart(){
        computeCap();
        var b = axisBounds();
        if (chart) chart.destroy();
        chart = new Chart(document.getElementById('analysisChart').getContext('2d'), {
            type:'scatter',
            data:{ datasets: buildDatasets() },
            options:{
                responsive:true, maintainAspectRatio:false, layout:{ padding:{ top:4, right:8 } },
                interaction:{ mode:'nearest', intersect:true },
                scales:{
                    x:{ min:b.xmin, max:b.xmax, title:{display:true, text:'Rent change vs prior year (%)'}, ticks:{ stepSize:b.xstep, callback:function(v){ return (v>0?'+':'')+v+'%'; } }, grid:{display:false} },
                    y:{ min:0, max:b.ymax, title:{display:true, text:'Surprise (ad-hoc) costs as % of rent'}, ticks:{ stepSize:b.ystep, callback:function(v){ return v+'%'; } }, grid:{display:false} }
                },
                plugins:{
                    legend:{ display:false },
                    tooltip:{ mode:'nearest', intersect:true,
                        filter:function(it, idx, arr){ return it.datasetIndex === arr[0].datasetIndex; },
                        callbacks:{
                        title:function(items){ return items[0].dataset.label; },
                        label:function(it){ var d=it.raw && it.raw._p; if(!d) return '';
                            return d.year+':  rent '+(d.x==null?'—':pctTxt(d.x))+'  ·  costs '+(d.y==null?'—':d.y.toFixed(1)+'% of rent'); }
                    }}
                }
            },
            plugins:[quadrantPlugin, labelPlugin]
        });
        bindCanvasHover();
    }

    function renderTable(){
        var body = document.getElementById('analysisTableBody'); body.innerHTML='';
        var den = ytdActive() ? DATA.ytd_cutoff_month : 12;
        var fy = focusYear();
        var rows = [];
        (DATA.properties||[]).forEach(function(p){
            var pt = pointFor(p, fy); if(!pt) return;
            if (!(pt.rent || pt.actual)) return;
            rows.push(pt);
        });
        rows.sort(function(a,b){ return (b.y||0)-(a.y||0); });
        rows.forEach(function(r){
            var tr=document.createElement('tr'); if(r.danger) tr.className='danger';
            var chg = (r.x==null) ? '<span class="an-src">—</span>'
                : '<span style="color:'+(r.x<0?'#dc3545':'#1f7a37')+';">'+pctTxt(r.x)+'</span>';
            tr.innerHTML =
                '<td>'+esc(r.name)+' <span class="an-src">('+esc(r.source)+')</span></td>'+
                '<td class="num">'+euro(r.rent)+'</td>'+
                '<td class="ctr">'+r.let+'/'+den+'</td>'+
                '<td class="num">'+euro(r.actual)+'</td>'+
                '<td class="num">'+(r.y==null?'—':r.y.toFixed(1)+'%')+'</td>'+
                '<td class="num">'+chg+'</td>'+
                '<td class="ctr">'+(r.danger?'<span class="an-flag warn">Watch</span>':'<span class="an-flag ok">OK</span>')+'</td>';
            body.appendChild(tr);
        });
        var flagged = rows.filter(function(r){ return r.danger; }).length;
        document.getElementById('analysisNote').innerHTML = flagged
            ? ('<i class="fas fa-exclamation-triangle" style="color:#dc3545;"></i> '+flagged+' propert'+(flagged>1?'ies':'y')+' in the watch zone.')
            : 'No properties in the watch zone.';
    }

    function updateChrome(){
        var badge=document.getElementById('analysisBadge'), sub=document.getElementById('analysisSub');
        var fy = focusYear();
        if (ytdActive()){
            badge.className='an-badge ytd';
            badge.textContent='YTD · Jan–'+DATA.ytd_month_name+' '+fy;
            sub.textContent = state.history
                ? 'Comet trail from '+state.from+' to '+state.to+'. '+fy+' is unfinished, so every year is trimmed to Jan–'+DATA.ytd_month_name+' for a like-for-like comparison.'
                : fy+' is unfinished, so it is shown year-to-date (Jan–'+DATA.ytd_month_name+'), compared to the same window last year.';
        } else {
            badge.className='an-badge full';
            badge.textContent = state.history ? (state.from+'–'+state.to+' · full years') : (fy+' · full year');
            sub.textContent = state.history
                ? 'Comet trail from '+state.from+' to '+state.to+' — each dot is a year on the property’s path.'
                : 'Snapshot of '+fy+' — one dot per property.';
        }
    }

    // Hovering a property's NAME LABEL on the chart (not just its dot) pops that
    // property's tooltip. Labels are canvas-drawn, so we track their hitboxes
    // (built in labelPlugin) and drive the tooltip when the cursor is over one.
    // Hovering a property's NAME LABEL shows a custom tooltip with that
    // property's info — in the history view, every year on its trail. (Dots keep
    // Chart.js's own tooltip, which shows the single comet circle you're over.)
    function bindCanvasHover(){
        var cv = document.getElementById('analysisChart'); if(!cv) return;
        var tip = document.getElementById('analysisTip');
        if(canvasHandler){ cv.removeEventListener('mousemove', canvasHandler.mm); cv.removeEventListener('mouseleave', canvasHandler.ml); }
        function hideTip(){ if(tip) tip.style.display='none'; }
        function mm(e){
            if(!chart || !labelHitboxes.length || !tip){ return; }
            var rect=cv.getBoundingClientRect();
            var x=e.clientX-rect.left, y=e.clientY-rect.top;
            var hit=null;
            for(var i=0;i<labelHitboxes.length;i++){ var h=labelHitboxes[i];
                if(x>=h.x && x<=h.x+h.w && y>=h.y && y<=h.y+h.h){ hit=h; break; } }
            if(!hit){ hideTip(); return; }
            var ds=chart.data.datasets[hit.di];
            var pts=((ds && ds.data) ? ds.data : []).map(function(d){ return d._p; }).filter(Boolean);
            if(!pts.length){ hideTip(); return; }
            var html='<div style="font-weight:700;margin-bottom:2px;">'+esc(ds.label)+'</div>';
            for(var j=0;j<pts.length;j++){ var pp=pts[j];
                html+='<div>'+pp.year+':&nbsp; rent '+(pp.x==null?'—':pctTxt(pp.x))+' &nbsp;·&nbsp; costs '+(pp.y==null?'—':pp.y.toFixed(1)+'% of rent')+'</div>'; }
            tip.innerHTML=html; tip.style.display='block';
            var ww=cv.clientWidth, wh=cv.clientHeight, tw=tip.offsetWidth, th=tip.offsetHeight;
            var tx=x+14, ty=y+14;
            if(tx+tw>ww) tx=x-14-tw; if(tx<2) tx=2;
            if(ty+th>wh) ty=y-14-th; if(ty<2) ty=2;
            tip.style.left=tx+'px'; tip.style.top=ty+'px';
        }
        canvasHandler={ mm:mm, ml:hideTip };
        cv.addEventListener('mousemove', mm);
        cv.addEventListener('mouseleave', hideTip);
    }

    function render(){ if(!DATA) return; updateChrome(); renderChart(); renderTable(); }

    function fillSelect(sel){
        sel.innerHTML='';
        (DATA.available_years||[]).slice().sort(function(a,b){ return b-a; }).forEach(function(y){
            var o=document.createElement('option'); o.value=y;
            o.textContent = y + (y===DATA.current_year ? ' (current)' : '');
            sel.appendChild(o);
        });
    }
    function buildControls(){
        var selY=document.getElementById('analysisYear');
        var selF=document.getElementById('analysisFrom');
        var selT=document.getElementById('analysisTo');
        if (selY.dataset.built === '1') return;
        fillSelect(selY); fillSelect(selF); fillSelect(selT);
        selY.value=state.year; selF.value=state.from; selT.value=state.to;
        selY.dataset.built='1';
        selY.addEventListener('change', function(){ state.year=parseInt(selY.value,10); render(); });
        selF.addEventListener('change', function(){
            state.from=parseInt(selF.value,10);
            if (state.from>state.to){ state.to=state.from; selT.value=state.to; }
            render();
        });
        selT.addEventListener('change', function(){
            state.to=parseInt(selT.value,10);
            if (state.to<state.from){ state.from=state.to; selF.value=state.from; }
            render();
        });
        document.getElementById('analysisHist').addEventListener('change', function(e){
            state.history=e.target.checked;
            document.getElementById('analysisSnapWrap').style.display  = e.target.checked ? 'none' : 'flex';
            document.getElementById('analysisRangeWrap').style.display = e.target.checked ? 'flex' : 'none';
            document.getElementById('analysisHistLbl').textContent = e.target.checked ? 'Showing history (comet trails)' : 'Show history (comet trails)';
            render();
        });
    }

    function load() {
        var loading = document.getElementById('analysisLoading');
        var empty = document.getElementById('analysisEmpty');
        var content = document.getElementById('analysisContent');
        loading.style.display='block'; empty.style.display='none'; content.style.display='none';
        fetch(ANALYSIS_URL, {headers: {'X-Requested-With': 'XMLHttpRequest'}})
            .then(function(r){ return r.json(); })
            .then(function(data) {
                DATA = data;
                if (!DATA.properties || !DATA.properties.length || !DATA.available_years || !DATA.available_years.length) {
                    loading.style.display='none'; empty.style.display='block'; return;
                }
                var asc = ascYears();
                state.year = asc[asc.length-1];
                state.from = asc[0];
                state.to   = asc[asc.length-1];
                buildControls();
                loading.style.display='none'; content.style.display='block';
                render();
            })
            .catch(function(err) {
                loading.innerHTML = '<span class="text-danger">Failed to load analysis.</span>';
                console.error('Analysis load error:', err);
            });
    }

    document.querySelectorAll('[data-target="#expenseAnalysisModal"]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!loaded) { loaded = true; load(); }
            else if (chart) { setTimeout(function(){ chart.resize(); }, 250); }
        });
    });
})();
</script>


