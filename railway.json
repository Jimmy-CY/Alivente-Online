{
  "build": {
    "builder": "NIXPACKS",
    "installCommand": "python -m pip install -r cron-requirements.txt"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn mysite.wsgi:application"
  },
  "crons": [
    {
      "name": "Lease Renewal Check",
      "schedule": "*/5 * * * *",
      "command": "python manage.py check_lease_renewals"
    }
  ]
}